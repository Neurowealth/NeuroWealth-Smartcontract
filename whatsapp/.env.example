# NeuroWealth WhatsApp bot — see docs/WHATSAPP_BOT.md
PORT=3000

# REQUIRED outside local dev. Generate with: openssl rand -hex 32
# Rotating ENCRYPTION_KEY makes existing custodial secrets undecryptable.
ENCRYPTION_KEY=
# Changing PHONE_HASH_SALT orphans all existing sessions and wallets.
PHONE_HASH_SALT=

# REQUIRED. Used to verify the X-Twilio-Signature header on every webhook
# request; without it all webhook requests are rejected.
TWILIO_AUTH_TOKEN=
# Public webhook URL exactly as configured in the Twilio console. Set it when
# running behind a proxy/tunnel so the signed URL matches.
TWILIO_WEBHOOK_URL=
# Local development only (ignored when NODE_ENV=production).
TWILIO_SKIP_SIGNATURE_VALIDATION=false

SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
VAULT_CONTRACT_ID=

# Vault limits in stroops (1 USDC = 10000000). Leave empty to use the contract
# defaults; set to the values of get_min_deposit / get_max_deposit /
# get_user_deposit_cap / get_tvl_cap if the owner changed them on-chain.
VAULT_MIN_DEPOSIT=
VAULT_MAX_DEPOSIT=
VAULT_USER_DEPOSIT_CAP=
VAULT_TVL_CAP=

# Rate limiting & lockout configuration (optional, defaults shown)
WHATSAPP_RATE_LIMIT_MAX_MESSAGES=10
WHATSAPP_RATE_LIMIT_WINDOW_MS=60000
WHATSAPP_OTP_MAX_ATTEMPTS=3
WHATSAPP_OTP_TTL_MS=300000
WHATSAPP_SESSION_TIMEOUT_MS=900000
WHATSAPP_MAX_SESSIONS=10000
