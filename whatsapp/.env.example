# NeuroWealth WhatsApp bot — see docs/WHATSAPP_BOT.md
PORT=3000

# REQUIRED (the service refuses to boot without it). Key-encryption key that
# wraps the per-wallet data keys. Generate with: openssl rand -hex 32
# Do NOT just replace it: follow the rotation runbook in docs/WHATSAPP_BOT.md
# (bump ENCRYPTION_KEY_VERSION, keep the old key in ENCRYPTION_KEY_RETIRED,
# then run `npm run rotate-keys`).
ENCRYPTION_KEY=
# Label stored with every wrapped data key (default 1). Change on every rotation.
ENCRYPTION_KEY_VERSION=1
# Previous keys during a rotation, as `version=key,version=key`. Empty otherwise.
ENCRYPTION_KEY_RETIRED=
# Changing PHONE_HASH_SALT orphans all existing sessions and wallets.
PHONE_HASH_SALT=

# REQUIRED. Postgres holding wallets, OTPs, sessions and webhook ledgers
# (apply supabase/migrations/*.sql). Default postgres:postgres credentials are
# rejected at boot. Format: postgresql://<user>:<password>@<host>:5432/<db>
DATABASE_URL=

# REQUIRED. Used to verify the X-Twilio-Signature header on every webhook
# request; without it all webhook requests are rejected.
TWILIO_AUTH_TOKEN=
# Outbound SMS configuration used to deliver WhatsApp account-verification OTPs.
TWILIO_ACCOUNT_SID=
TWILIO_SMS_FROM=
# Public webhook URL exactly as configured in the Twilio console. Set it when
# running behind a proxy/tunnel so the signed URL matches.
TWILIO_WEBHOOK_URL=
# Local development only; the service refuses to boot with true when NODE_ENV=production.
TWILIO_SKIP_SIGNATURE_VALIDATION=false

# REQUIRED to deliver OTP codes via SMS (#942). Account SID and sender number
# from the Twilio console; OTP codes are never echoed in the WhatsApp reply.
TWILIO_ACCOUNT_SID=
TWILIO_SMS_FROM_NUMBER=

SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
VAULT_CONTRACT_ID=

# Vault limits in stroops (1 USDC = 10000000). Leave empty to use the contract
# defaults; set to the values of get_min_deposit / get_max_deposit /
# get_user_deposit_cap / get_tvl_cap if the owner changed them on-chain.
VAULT_MIN_DEPOSIT=
VAULT_MAX_DEPOSIT=
VAULT_USER_DEPOSIT_CAP=
VAULT_TVL_CAP=

# Rate limiting & lockout configuration (optional, defaults shown)
WHATSAPP_RATE_LIMIT_MAX_MESSAGES=10
WHATSAPP_RATE_LIMIT_WINDOW_MS=60000
WHATSAPP_OTP_MAX_ATTEMPTS=3
WHATSAPP_OTP_TTL_MS=300000
WHATSAPP_SESSION_TIMEOUT_MS=900000
WHATSAPP_WEBHOOK_LEASE_MS=120000
