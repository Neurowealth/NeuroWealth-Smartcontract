# =============================================================================
# NeuroWealth AI Decision Agent — Environment Configuration Template (#752)
# =============================================================================
# Copy this file to agent/.env and configure values for your environment.
# Never commit the real .env file or sensitive credentials to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Server Configuration
# -----------------------------------------------------------------------------
# Port for the agent HTTP API server (default: 3001)
PORT=3001

# Application environment ('development', 'test', 'production')
NODE_ENV=development

# Logging verbosity ('trace', 'debug', 'info', 'warn', 'error', 'fatal')
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL / Supabase)
# -----------------------------------------------------------------------------
# PostgreSQL connection string for user strategies, rebalances, and ledger cursor.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=

# PostgreSQL connection pool settings
MAX_DB_POOL_SIZE=10
MIN_DB_POOL_SIZE=2
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# 3. Stellar & Soroban Network Configuration
# -----------------------------------------------------------------------------
# Soroban RPC server endpoint
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Stellar Network Passphrase
# Testnet: 'Test SDF Network ; September 2015'
# Mainnet: 'Public Global Stellar Network ; July 2015'
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Deployed Vault Soroban smart contract ID (starts with C...)
VAULT_CONTRACT_ID=

# Alternative vault address alias used by transaction runners
VAULT_ADDRESS=

# Agent Stellar secret key / seed used to sign on-chain rebalances and compounding transactions
# Keep empty or use a placeholder in templates; provide a valid S... seed in local .env
SOROBAN_SECRET_KEY=

# -----------------------------------------------------------------------------
# 4. Event Listener & Cursor Persistence
# -----------------------------------------------------------------------------
# Optional starting ledger sequence for Soroban event polling when no saved cursor exists.
# If unset, event polling begins at the current latest ledger sequence.
START_LEDGER=

# Fallback file path for storing the event listener paging token when DATABASE_URL is unset
LEDGER_CURSOR_FILE=.agent-state/ledger-cursor.json

# -----------------------------------------------------------------------------
# 5. Metrics & Health Monitoring (#652)
# -----------------------------------------------------------------------------
# HTTP port for the standalone Prometheus/health metrics server (default: 9100)
METRICS_PORT=9100

# -----------------------------------------------------------------------------
# 6. Rate Limiting & Retry Configuration
# -----------------------------------------------------------------------------
# Maximum retries for network and RPC calls (default: 3)
MAX_RETRIES=3

# Rate limit time window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per IP address within the rate limit window
RATE_LIMIT_MAX_REQUESTS=30

# Maximum requests per authenticated user within the rate limit window
USER_RATE_LIMIT_MAX_REQUESTS=20

# -----------------------------------------------------------------------------
# 7. AI & Intent Parsing (OpenAI)
# -----------------------------------------------------------------------------
# Primary OpenAI API key for natural language command parsing
OPENAI_API_KEY=

# Comma-separated list of OpenAI API keys for automatic key rotation
OPENAI_API_KEYS=

# -----------------------------------------------------------------------------
# 8. OpenTelemetry & Distributed Tracing
# -----------------------------------------------------------------------------
# OpenTelemetry OTLP collector / Jaeger HTTP endpoint for distributed tracing
JAEGER_ENDPOINT=http://localhost:4318/v1/traces
