# E2E test artifacts (generated at runtime)
scripts/e2e-artifacts/*
!scripts/e2e-artifacts/.gitkeep

# AI / local planning files
CLAUDE.md
plan.md
issue.md
pr.md

# Node
node_modules/
**/node_modules/

# Next.js build output
.next/
out/

# Build / compile output
dist/
build/
target/

.env
.env.local
.env.devnet
.env.testnet
.env.mainnet
.env.*.local
# Any other env variant (.env.production, .env.staging, ...) — templates only (#766)
.env.*
!.env.*.template
!.env.example
!.env.*.example
!.env.sample

# Private-key material (#766) — enforced by scripts/check-env-templates.py
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
__pycache__/
*.py[cod]

# Test snapshots (cargo-test / proptest regressions)
**/test_snapshots/
**/*.snap
**/*.snap.new
# proptest regression files
proptest-regressions/
**/proptest-regressions/

# Stellar / Soroban local state
.soroban/
.stellar/

# Deployed contract address caches (generated by scripts)
scripts/devnet-contracts.env
scripts/testnet-contracts.env
scripts/mainnet-contracts.env

# Editor / IDE files
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# TypeScript compiled output
*.js.map
*.d.ts.map
*.tsbuildinfo

# Coverage reports
coverage/
lcov.info

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Package manager lock files (only keep the canonical one per sub-project)
# The root repo does not have a single package manager — leave sub-project
# lockfiles committed so CI gets reproducible installs.

# Temporary files
*.tmp
*.bak

# Agent local state (ledger cursor fallback)
.agent-state/

fix.md